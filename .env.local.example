# SALTD × Shopify — copy this file to `.env.local` and fill in your store's values.
# `.env.local` is gitignored; never commit real tokens.
#
# Where to find these (one-time, in Shopify admin):
#   Settings → Apps and sales channels → Develop apps → Create an app ("SALTD Web")
#   → Configuration → Storefront API → enable scopes:
#       unauthenticated_read_product_listings
#       unauthenticated_read_product_inventory
#       unauthenticated_write_checkouts
#       unauthenticated_read_checkouts
#   → Install app → copy the "Storefront API access token".
#
# These stay SERVER-ONLY (no NEXT_PUBLIC_ prefix): the token is never shipped to
# the browser. Product data is fetched server-side and cached; checkout runs
# through a Server Action.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_access_token
# Optional — defaults to a recent stable version if omitted.
SHOPIFY_API_VERSION=2024-10

# --- Guest order tracking (Admin API) ---------------------------------------
# The /account "Track order" tab (order ID + email, no login) needs the Admin API,
# which the Storefront token can't do. Create/extend a custom app with the
# `read_orders` Admin scope, install it, and paste its Admin API access token here.
# Leave blank and order tracking shows a "not connected" message; sign-in order
# history still works without it.
SHOPIFY_ADMIN_TOKEN=

# --- Customer accounts (sign in / register) ---------------------------------
# Uses the Storefront token above. Requires classic (password) customer accounts
# enabled in Shopify, plus these Storefront API scopes on the app:
#   unauthenticated_read_customers, unauthenticated_write_customers
# (Your current token already passed the check — no action needed unless it breaks.)

# --- Product matching -------------------------------------------------------
# Each Shopify product's HANDLE should match a slug the site already styles so it
# picks up the 3D stick, gallery, nutrition, accent colour, etc:
#   banta-lime-spark, kala-khatta, peach-himalayan
# New products with other handles still appear — they just render with Shopify's
# own images/description and default styling until an overlay is added in
# src/lib/flavours.ts.
#
# Pack sizes come from each product's VARIANTS. Name a variant option so its
# title contains the stick count, e.g. "10 sticks" and "30 sticks"; the site
# parses the number for the "₹/serve" math and the pack picker.
